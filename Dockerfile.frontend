# ---- Build ----
FROM node:20-alpine AS build
WORKDIR /build
COPY frontend/package*.json ./
RUN npm install --legacy-peer-deps
COPY frontend/ ./
ENV NEXT_PUBLIC_API_URL=https://treasury-ms-api.onrender.com
RUN npm run build

# ---- Production ----
FROM node:20-alpine
WORKDIR /app
COPY --from=build /build/.next/standalone ./
COPY --from=build /build/.next/static ./.next/static

# Render injects HOSTNAME=<pod-name> into the container; Next.js's
# standalone server binds to that instead of the wildcard address if
# set, so the platform's proxy can't reach it. Force it back to 0.0.0.0.
CMD ["sh", "-c", "HOSTNAME=0.0.0.0 node server.js"]
